# Target environment: local | dev | qa | stage | prod
TEST_ENV=prod

# URL overrides — optional, defaults come from src/ecomapp/config/environments/<env>.py
# Must include the scheme (http:// or https://).
# BASE_URL=https://muvake.com
# API_BASE_URL=https://api.muvake.com

# Admin credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Standard test user
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
